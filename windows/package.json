{
  "name": "macshare-win",
  "productName": "TwinDesk",
  "version": "3.1.1",
  "description": "TwinDesk for Windows: pair with a Mac, view its screen, share mouse, keyboard and clipboard.",
  "license": "GPL-3.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:monitor": "electron . --test-monitor",
    "build:helper": "..\\windows-helper\\build.cmd",
    "fetch-adb": "node scripts/fetch-adb.js",
    "dist": "node installer/build.js",
    "dist:store": "node installer/build.js store x64 arm64",
    "dist:portable": "node installer/build.js portable"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "26.0.12"
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
