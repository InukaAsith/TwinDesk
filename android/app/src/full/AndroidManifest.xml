<!-- TwinDesk — Copyright (C) 2026 inukaasith. GPL-3.0, see LICENSE.
     The full build only: notification access (the phone’s notifications on the computer) and
     the SMS permissions (Messages on the computer).
     The computer installs this build over the standard one through wireless debugging. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Messages on the computer (Messages.kt): read the phone's texts and send them. Asked for
         only when Messages is switched on. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <application>
        <service
            android:name=".NotifListener"
            android:exported="true"
            android:label="TwinDesk Mesh"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
